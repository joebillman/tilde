<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows version in the target gives access to Windows APIs such as
         StartupTask, which the Store build needs for Start with Windows. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Tilde</AssemblyName>
    <RootNamespace>Tilde.App</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Generated from TildeGlyph by packaging/AssetGenerator. -->
    <ApplicationIcon>Tilde.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Match the manifest: draw at each monitor's real scaling. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WinForms prefers DPI settings only in the project, not the manifest
         (WFO0003). The Store's certification kit reads only the manifest, so
         both are needed. They say the same thing. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK adds this namespace to every app by default. Tilde never uses the
         network (AGENTS.md Hard rule 1), so remove it to make that plain. -->
    <Using Remove="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tilde.Core\Tilde.Core.csproj" />
  </ItemGroup>

</Project>
